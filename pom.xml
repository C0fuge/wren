<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Standalone since the split from the server repository (kestrel). The parent's settings
         are vendored below; the server's artifacts (client core, server + its test-jar) come from
         the local Maven repository: scripts/install-kestrel.sh builds them at the commit pinned
         in kestrel.ref. -->
    <groupId>pro.surpin.arrowflight</groupId>
    <artifactId>arrow-flight-spark-connector</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Arrow Flight Spark Connector</name>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Version of the server repository's artifacts (built locally from kestrel.ref). -->
        <kestrel.version>1.0.0</kestrel.version>
        <arrow.version>19.0.0</arrow.version>
        <!-- Spark build line: 3.5 / Scala 2.12 by default; -Pspark-3.3, -Pspark-3.4, -Pspark-4.0
             (Scala 2.13) switch it (see the spark-* profiles and the CI matrix). -->
        <spark.version>3.5.9</spark.version>
        <scala.binary.version>2.12</scala.binary.version>
        <junit.version>5.14.4</junit.version>
        <!-- Spark local-mode and in-process server tests run by default; perf and real-services
             only on request (-Pperf / -Preal-services). -->
        <excludedGroups>perf,real-services</excludedGroups>
        <skipTests>false</skipTests>
        <!-- JVM options of the test JVMs (surefire and failsafe). -->
        <test.jvm.options>-ea --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
            --add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED</test.jvm.options>
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <netty.version>4.2.19.Final</netty.version>
        <jackson.version>2.21.8</jackson.version>
    </properties>
    <!-- One Netty version for Arrow, gRPC, Spark and the server under test (the epoll transport
         fails on a mix of 4.1 and 4.2 modules); as in flight-server. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- One Jackson version, as in flight-client-core. The shaded jar relocates it, so the
                 connector keeps it while Spark 3.5 runs its own 2.15 (and the BOM lifts the Scala
                 module of the provided Spark to the same version for the tests). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-client-core</artifactId>
            <version>${kestrel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>flight-sql</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>flight-core</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.3-jre</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.34.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>3.5.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs</artifactId>
            <version>3.5.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-server</artifactId>
            <version>${kestrel.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-server</artifactId>
            <version>${kestrel.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- An in-process KDC for the Kerberos tests (Kerby as in Hadoop 3.5.0 and the server's tests). -->
        <dependency>
            <groupId>org.apache.kerby</groupId>
            <artifactId>kerb-simplekdc</artifactId>
            <version>2.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>jacoco-report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                </executions>
                <configuration><excludes><exclude>**/debug/**</exclude></excludes></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration><release>21</release><fork>true</fork></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <argLine>@{argLine} ${test.jvm.options}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <!-- Spark is provided and brings slf4j itself. -->
                            <artifactSet><excludes><exclude>org.slf4j:*</exclude></excludes></artifactSet>
                            <!-- Everything the connector bundles that Spark or the cluster's Hadoop also
                                 ship is relocated, so the connector runs on the versions it was built
                                 with whatever comes first on the class path: Spark 3.5 ships Jackson
                                 2.15, Arrow 12 (with FlatBuffers 1.12), Netty 4.1, commons-lang3 3.12;
                                 Hadoop 3.1.3 Guava 27, protobuf 2.5, Netty 4.1 / 3, Gson. With Spark's
                                 Arrow 12 first, an unrelocated Arrow hangs the first read (found and
                                 checked by ShadedJarHadoop313IT). -->
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.arrow</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.arrow</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.flatbuffers</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.flatbuffers</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.netty</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.io.netty</shadedPattern>
                                </relocation>
                                <!-- Netty loads its native libraries (epoll, tcnative, ...) under the
                                     relocated package's prefix: lib<prefix with _>_netty_*. -->
                                <relocation>
                                    <pattern>META-INF/native/libnetty_</pattern>
                                    <shadedPattern>META-INF/native/libpro_surpin_data_arrowflight_shaded_netty_</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>META-INF/native/netty_</pattern>
                                    <shadedPattern>META-INF/native/pro_surpin_data_arrowflight_shaded_netty_</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>io.grpc</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.io.grpc</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.perfmark</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.io.perfmark</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.protobuf</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.thirdparty</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.guava.thirdparty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons</pattern>
                                    <shadedPattern>pro.surpin.data.arrowflight.shaded.commons</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter><artifact>*:*</artifact><excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                    <!-- Multi-release copies are not relocated by the shade plugin and
                                         never loaded (the shaded jar is not Multi-Release). -->
                                    <exclude>META-INF/versions/*/com/fasterxml/**</exclude>
                                </excludes></filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The shaded jar next to a Hadoop 3.1.3 client (ShadedJarHadoop313IT): resolve the
                 class path of a "Hadoop free" Spark of this build line plus Hadoop 3.1.3 from
                 src/test/hadoop-3.1.3/pom.xml (a nested Maven run: one artifact cannot have two
                 versions in this pom), then run the *IT tests after package. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>hadoop-3.1.3-classpath</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>${maven.home}/bin/mvn</executable>
                            <arguments>
                                <argument>--batch-mode</argument>
                                <argument>--quiet</argument>
                                <argument>--file=${project.basedir}/src/test/hadoop-3.1.3/pom.xml</argument>
                                <argument>-Dmaven.repo.local=${settings.localRepository}</argument>
                                <argument>-Dspark.version=${spark.version}</argument>
                                <argument>-Dscala.binary.version=${scala.binary.version}</argument>
                                <argument>-Dmdep.outputFile=${project.build.directory}/hadoop-3.1.3.classpath</argument>
                                <argument>dependency:build-classpath</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <argLine>@{argLine} ${test.jvm.options}</argLine>
                </configuration>
                <executions>
                    <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies><dependency>
                    <groupId>com.puppycrawl.tools</groupId>
                    <artifactId>checkstyle</artifactId>
                    <version>10.26.1</version>
                </dependency></dependencies>
                <configuration>
                    <configLocation>${project.basedir}/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <failOnViolation>${checkstyle.failOnViolation}</failOnViolation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <sourceDirectories><sourceDirectory>${project.basedir}/src/main/java</sourceDirectory></sourceDirectories>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.3.0</version>
                <configuration>
                    <effort>Max</effort><threshold>Medium</threshold><failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Spark build lines. 3.5 is the default (the properties above); its profile only names it
             so that every CI matrix entry passes one. -->
        <profile>
            <id>spark-3.3</id>
            <properties>
                <spark.version>3.3.4</spark.version>
                <scala.binary.version>2.12</scala.binary.version>
            </properties>
        </profile>
        <profile>
            <id>spark-3.4</id>
            <properties>
                <spark.version>3.4.4</spark.version>
                <scala.binary.version>2.12</scala.binary.version>
            </properties>
        </profile>
        <profile>
            <id>spark-3.5</id>
            <properties>
                <spark.version>3.5.9</spark.version>
                <scala.binary.version>2.12</scala.binary.version>
            </properties>
        </profile>
        <profile>
            <id>spark-4.0</id>
            <properties>
                <spark.version>4.0.5</spark.version>
                <scala.binary.version>2.13</scala.binary.version>
            </properties>
        </profile>
        <profile>
            <id>perf</id>
            <properties>
                <groups>perf</groups>
                <excludedGroups />
            </properties>
        </profile>
        <profile>
            <id>real-services</id>
            <properties>
                <groups>real-services</groups>
                <excludedGroups />
            </properties>
        </profile>
    </profiles>
</project>
